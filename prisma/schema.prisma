generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KeyStatus {
  ACTIVE
  REVOKED
}

model Team {
  id               String     @id @default(cuid())
  name             String     @unique
  monthlyBudgetUsd Decimal    @default(50) @db.Decimal(10, 2)
  createdAt        DateTime   @default(now())
  keys             ApiKey[]
  usage            UsageLog[]
}

// Only the SHA-256 hash of a key is stored. The raw key is shown once at creation.
model ApiKey {
  id         String     @id @default(cuid())
  teamId     String
  team       Team       @relation(fields: [teamId], references: [id])
  prefix     String
  hash       String     @unique
  label      String?
  status     KeyStatus  @default(ACTIVE)
  createdAt  DateTime   @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
  usage      UsageLog[]

  @@index([teamId])
}

model UsageLog {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  keyId        String
  key          ApiKey   @relation(fields: [keyId], references: [id])
  provider     String   @default("ollama")
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs    Int
  status       Int
  error        String?
  createdAt    DateTime @default(now())

  @@index([teamId, createdAt])
  @@index([keyId, createdAt])
}

model ModelPrice {
  model         String   @id
  inputPerMTok  Decimal  @db.Decimal(10, 4)
  outputPerMTok Decimal  @db.Decimal(10, 4)
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}